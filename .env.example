# =============================================================================
# BLADE Configuration
# =============================================================================
# 复制此文件为 .env 并填写实际的配置值
#
# 配置分为两类：
# 1. Environment Config: 启动前必须设置，运行时不可修改
# 2. Runtime Settings: 可通过管理后台修改（默认值可在此设置）


# =============================================================================
# Application (应用配置)
# =============================================================================
APP_NAME=BLADE
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# Version Info
APP_VERSION=3.1.0
ENGINE_VERSION=3.1.0
RELEASE_DATETIME=2025.12.18


# =============================================================================
# Database - PostgreSQL (数据库配置)
# =============================================================================
# 单数据库，多 schema:
#   - public schema: TPL 知识库数据 (meta_*, feature_*, r_*)
#   - user_data schema: 用户数据 (users, tasks, settings)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=blade
POSTGRES_PASSWORD=blade
POSTGRES_DATABASE=blade


# =============================================================================
# Redis (缓存与消息队列)
# =============================================================================
REDIS_HOST=blade-redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis 数据库分配
REDIS_DB_BROKER=0
REDIS_DB_RESULT=0
REDIS_DB_METADATA=2


# =============================================================================
# MinIO (对象存储)
# =============================================================================
# MinIO 服务器地址 (不包含 http://)
MINIO_ENDPOINT=localhost:9000
# MinIO 访问密钥
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# 是否使用 HTTPS
MINIO_SECURE=false
# 存储桶名称
MINIO_INPUT_BUCKET=input-files
MINIO_OUTPUT_BUCKET=output-files
# 本地临时目录
LOCAL_WORKSPACE_DIR=/tmp/workspace


# =============================================================================
# Authentication (认证配置)
# =============================================================================
# JWT 密钥 (请更改为安全的随机字符串)
AUTH_SECRET=your_secure_secret_key_change_me

# Google OAuth (从 Google Cloud Console 获取)
GOOGLE_CLIENT_ID=your_google_client_id_here

# 管理员邮箱列表 (逗号分隔)
ADMIN_EMAILS=admin@example.com


# =============================================================================
# LLM (大语言模型配置)
# =============================================================================
# LLM 提供商: openai, anthropic, ollama
LLM_PROVIDER=openai
# 模型 ID
LLM_MODEL_ID=gpt-4.1

# API 密钥 (根据选择的提供商填写)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama 配置 (如果使用 Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# LLM 价格配置 (每百万 token 的价格，用于成本计算)
LLM_INPUT_TOKEN_PRICE=2.0
LLM_OUTPUT_TOKEN_PRICE=8.0
LLM_CACHED_INPUT_TOKEN_PRICE=0.5


# =============================================================================
# Runtime Settings (运行时设置 - 可通过管理后台修改)
# =============================================================================
# 注意：这些设置也可以在管理后台的"系统设置"中动态修改
# 此处的值作为初始默认值

# Token 过期时间 (小时), 默认 7 天
AUTH_TOKEN_EXPIRE_HOURS=168

# 访客分析次数限制
GUEST_ANALYSIS_LIMIT=3

# 是否清理分析临时文件
CLEANUP_ANALYSIS_FILES=false

# 批量刷新并发数
BATCH_REFRESH_CONCURRENCY=4
