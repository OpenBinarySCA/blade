# =============================================================================
# BLADE Production Configuration
# =============================================================================
# Copy this file to ../.env (project root) and fill in your actual values
# IMPORTANT: Never commit the actual .env file with sensitive data!


# =============================================================================
# Application (应用配置)
# =============================================================================
APP_NAME=BLADE
APP_HOST=0.0.0.0
APP_PORT=8000
# IMPORTANT: Set to false in production!
APP_DEBUG=false

# Version Info
APP_VERSION=3.1.0
ENGINE_VERSION=3.1.0
RELEASE_DATETIME=2025.12.18


# =============================================================================
# Database - PostgreSQL (数据库配置)
# =============================================================================
# Single database with multiple schemas:
#   - public schema: TPL knowledge base
#   - user_data schema: user data
# For Docker deployment, use service names:
POSTGRES_HOST=blade-postgresql
POSTGRES_PORT=5432
POSTGRES_USERNAME=blade
# IMPORTANT: Change this password in production!
POSTGRES_PASSWORD=your_secure_database_password
POSTGRES_DATABASE=blade


# =============================================================================
# Redis (缓存与消息队列)
# =============================================================================
REDIS_HOST=blade-redis
REDIS_PORT=6379
# IMPORTANT: Set a strong password in production!
REDIS_PASSWORD=your_secure_redis_password
REDIS_DB_BROKER=0
REDIS_DB_RESULT=0
REDIS_DB_METADATA=2


# =============================================================================
# MinIO (对象存储)
# =============================================================================
MINIO_ENDPOINT=blade-minio:9000
# IMPORTANT: Change these credentials in production!
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_SECURE=false
MINIO_INPUT_BUCKET=input-files
MINIO_OUTPUT_BUCKET=output-files
LOCAL_WORKSPACE_DIR=/tmp/workspace


# =============================================================================
# Authentication (认证配置)
# =============================================================================
# IMPORTANT: Use a strong, random secret key in production!
AUTH_SECRET=your_very_secure_random_secret_key_at_least_32_chars

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id

# Admin emails (comma-separated)
ADMIN_EMAILS=admin@yourdomain.com


# =============================================================================
# LLM (大语言模型配置)
# =============================================================================
# LLM Provider: openai, anthropic, ollama
LLM_PROVIDER=openai
LLM_MODEL_ID=gpt-4.1

# API Keys (fill in based on your chosen provider)
# IMPORTANT: Replace with your actual API keys!
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Ollama (if using local LLM)
OLLAMA_BASE_URL=http://localhost:11434


# =============================================================================
# Runtime Settings (运行时设置)
# =============================================================================
# These can also be modified via admin panel at runtime

# Token expiration (hours), default 7 days
AUTH_TOKEN_EXPIRE_HOURS=168

# Guest analysis limit
GUEST_ANALYSIS_LIMIT=3

# Cleanup analysis temp files
CLEANUP_ANALYSIS_FILES=true

# Batch refresh concurrency
BATCH_REFRESH_CONCURRENCY=4
